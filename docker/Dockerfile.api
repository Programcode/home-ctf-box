# OpenRange control-plane API image.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.api -t openrange-api:dev .
#
# Multi-stage: uv resolves the frozen workspace lockfile in a builder stage,
# the runtime ships only the compiled virtualenv plus Alembic scripts. The
# container runs as uid 10001 and reports readiness at /api/readyz.

FROM python:3.12-slim-bookworm AS builder

# Pinned uv release; must be able to read uv.lock (revision 3).
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    # Build the virtualenv directly at its final runtime path so entrypoint
    # shebangs survive the stage copy.
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /build

# Workspace manifest first for layer caching, then member sources.
COPY pyproject.toml uv.lock ./
COPY apps/api/ apps/api/
COPY apps/lab-gateway/ apps/lab-gateway/
COPY apps/lab-runner/ apps/lab-runner/
COPY packages/ packages/

# Sync every workspace member: openrange-api imports openrange.content
# (packages/content-sdk) at startup without declaring it as a dependency,
# so a single-package sync would produce an image that crashes on boot.
RUN uv sync --frozen --no-dev --all-packages --no-editable

FROM python:3.12-slim-bookworm AS runtime

# Dedicated unprivileged identity; no shell, no ownership of app code.
RUN groupadd --gid 10001 --system openrange \
    && useradd --uid 10001 --gid 10001 --system --home-dir /nonexistent \
       --shell /usr/sbin/nologin openrange

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY apps/api/alembic.ini /app/
COPY apps/api/alembic /app/alembic

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    CONTENT_DIR=/app/content

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/readyz', timeout=4).status == 200 else 1)"]

# Migrations run separately via the one-shot `migrate` compose service:
#   docker compose -f infra/compose/production.yml run --rm migrate
CMD ["uvicorn", "openrange.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
