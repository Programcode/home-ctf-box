# OpenRange lab gateway image.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.gateway -t openrange-gateway:dev .
#
# Same uv pattern as the API image; the runtime is a slim Python base with
# the compiled virtualenv only, running as uid 10001 with a /healthz probe.

FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    # Build the virtualenv directly at its final runtime path so entrypoint
    # shebangs survive the stage copy.
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /build

COPY pyproject.toml uv.lock ./
COPY apps/api/ apps/api/
COPY apps/lab-gateway/ apps/lab-gateway/
COPY apps/lab-runner/ apps/lab-runner/
COPY packages/ packages/

RUN uv sync --frozen --no-dev --package openrange-gateway --no-editable

FROM python:3.12-slim-bookworm AS runtime

RUN groupadd --gid 10001 --system openrange \
    && useradd --uid 10001 --gid 10001 --system --home-dir /nonexistent \
       --shell /usr/sbin/nologin openrange

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    OPENRANGE_GATEWAY_HOST=0.0.0.0 \
    OPENRANGE_GATEWAY_PORT=8772

USER 10001:10001
EXPOSE 8772

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=5 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8772/healthz', timeout=4).status == 200 else 1)"]

CMD ["openrange-gateway"]
