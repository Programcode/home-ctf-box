{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s by status class)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "openrange-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (label_replace(rate(openrange_http_requests_total[5m]), \"status_class\", \"$1xx\", \"status\", \"([0-9]).*\"))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Average latency (no histogram yet, p95 lands with buckets)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "openrange-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(openrange_http_request_duration_seconds_sum[5m])) / sum(rate(openrange_http_request_duration_seconds_count[5m]))",
          "legendFormat": "avg latency"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error ratio (5xx share of all requests)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "openrange-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          },
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(openrange_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(openrange_http_requests_total[5m]))",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "DB connection pool",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "openrange-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "openrange_db_pool_size",
          "legendFormat": "pool size"
        },
        {
          "refId": "B",
          "expr": "openrange_db_pool_checked_out",
          "legendFormat": "checked out"
        }
      ]
    },
    {
      "id": 5,
      "title": "API process uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "openrange-prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "openrange_process_uptime_seconds",
          "legendFormat": "uptime"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["openrange"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "OpenRange API overview",
  "uid": "openrange-api-overview",
  "version": 1,
  "weekStart": ""
}
