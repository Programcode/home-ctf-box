  },
  "dependencies": {
    "@openrange/contracts": "workspace:*",
    "@openrange/ui": "workspace:*",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@openrange/tsconfig": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "turbo": {
    "extends": [
      "//"
    ],
    "tasks": {
      "typecheck": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
