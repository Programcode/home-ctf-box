# OpenRange configuration template.
# Copy to .env for local development: `cp .env.example .env`.
# The typed validator (packages/config) fails closed on missing values
# in production mode; dev mode fills safe local defaults.

# --- Deployment identity ---
OPENRANGE_ENV=dev                 # dev | staging | production
OPENRANGE_EDITION=community       # community | cluster
OPENRANGE_PUBLIC_URL=http://localhost:3000

# --- Secrets (generate real values before any non-local deployment) ---
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-key-change-me-32bytes-minimum-padding
FLAG_MASTER_KEY=dev-only-flag-master-key-change-me-0000000000000000
DATABASE_URL=postgresql+asyncpg://openrange:openrange@localhost:15432/openrange
REDIS_URL=redis://localhost:16379/0

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=openrange-dev
S3_SECRET_KEY=openrange-dev-secret
S3_BUCKET=openrange

# --- Search ---
MEILI_URL=http://localhost:17700
MEILI_MASTER_KEY=dev-only-meili-master-key

# --- Lab runtime ---
RUNNER_API_URL=http://localhost:8771
RUNNER_API_TOKEN=dev-only-runner-token
LAB_NETWORK_PREFIX=172.30.0.0/16
LAB_DEFAULT_TTL_MINUTES=90
LAB_MAX_CONCURRENCY_PER_USER=2

# --- Email (Mailpit in dev; configure SMTP before inviting real users) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@openrange.local
SMTP_TLS=false

# --- Web app (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8700

# --- Legacy v0 demo stack ---
CTF_BIND=127.0.0.1
PLATFORM_PORT=8000
