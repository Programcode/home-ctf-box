# OpenRange configuration template.
# Copy to .env for local development: `cp .env.example .env`.
# The typed validator (packages/config) fails closed on missing values
# in production mode; dev mode fills safe local defaults.

# --- Deployment identity ---
OPENRANGE_ENV=dev                 # dev | staging | production
OPENRANGE_EDITION=community       # community | cluster
OPENRANGE_PUBLIC_URL=http://localhost:3000

# --- Secrets (generate real values before any non-local deployment) ---
# python3 -c "import secrets; print(secrets.token_hex(32))"
OPENRANGE_SECRET_KEY=dev-only-secret-key-change-me-32bytes-minimum-padding
OPENRANGE_FLAG_MASTER_KEY=dev-only-flag-master-key-change-me-0000000000000000
OPENRANGE_DATABASE_URL=postgresql+asyncpg://openrange:openrange@localhost:15432/openrange
OPENRANGE_REDIS_URL=redis://localhost:16379/0

# --- Object storage (MinIO in dev) ---
OPENRANGE_S3_ENDPOINT=http://localhost:19000
OPENRANGE_S3_ACCESS_KEY=openrange-dev
OPENRANGE_S3_SECRET_KEY=openrange-dev-secret
OPENRANGE_S3_BUCKET=openrange

# --- Search ---
OPENRANGE_MEILI_URL=http://localhost:17700
OPENRANGE_MEILI_MASTER_KEY=dev-only-meili-master-key

# --- Lab runtime ---
OPENRANGE_RUNNER_API_URL=http://localhost:8771
OPENRANGE_RUNNER_API_TOKEN=dev-only-runner-token
OPENRANGE_LAB_NETWORK_PREFIX=172.30.0.0/16
OPENRANGE_LAB_DEFAULT_TTL_MINUTES=90
OPENRANGE_LAB_MAX_CONCURRENCY_PER_USER=2

# --- Email (Mailpit in dev; configure SMTP before inviting real users) ---
OPENRANGE_SMTP_HOST=localhost
OPENRANGE_SMTP_PORT=1025
OPENRANGE_SMTP_FROM=no-reply@openrange.local
OPENRANGE_SMTP_TLS=false

# --- Web app (Next.js) ---
# Next.js reads NEXT_PUBLIC_* unprefixed by framework convention
NEXT_PUBLIC_API_URL=http://localhost:8700

# --- Legacy v0 demo stack ---
CTF_BIND=127.0.0.1
PLATFORM_PORT=8000
